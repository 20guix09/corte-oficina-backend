{
  "info": {
    "name": "Corte Oficina - Etapa 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Execute em ordem. A criação salva projectId. Dados em memória. Para Codespaces público de teste, substitua baseUrl e remova / final. Use somente dados fictícios."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Verificar servidor",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Listar projetos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/projetos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Criar projeto e guardar ID",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/projetos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Armário de teste\",\n  \"cliente\": \"Cliente exemplo\",\n  \"pedido\": \"PED-001\",\n  \"observacoes\": \"Projeto fictício da etapa 1.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"projectId\", pm.response.json().dados.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Consultar projeto criado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/projetos/{{projectId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Atualizar projeto completo",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/projetos/{{projectId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Armário revisado\",\n  \"cliente\": \"Cliente exemplo\",\n  \"pedido\": \"PED-001\",\n  \"observacoes\": \"Revisão de cadastro.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Rejeitar nome vazio",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/projetos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Excluir projeto",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/projetos/{{projectId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Confirmar exclusão",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/projetos/{{projectId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}