        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/projetos/{{projetoId}}/importar",
        "body": {
          "mode": "raw",
          "raw": "{\"versao\": {{projetoVersao}}, \"xml\": \"<?xml version=\\\"1.0\\\" encoding=\\\"utf-8\\\"?>\\n<LISTING ID=\\\"Listagem_chapas\\\" UNIT=\\\"MM\\\"><AMBIENTS><AMBIENT><CATEGORIES><CATEGORY><ITEMS>\\n<ITEM ID=\\\"grupo\\\"><ITEMS>\\n<ITEM UNIQUEID=\\\"PORTA\\\" DESCRIPTION=\\\"Porta demonstracao\\\" WIDTH=\\\"600\\\" DEPTH=\\\"700\\\" HEIGHT=\\\"15\\\" REPETITION=\\\"2\\\" PLATECUTTINGROTATE=\\\"NONE\\\"><REFERENCES><MATERIAL REFERENCE=\\\"MDF\\\"/><MODEL REFERENCE=\\\"Branco\\\"/><THICKNESS REFERENCE=\\\"15\\\"/><MAXWIDTH REFERENCE=\\\"2750\\\"/><MAXDEPTH REFERENCE=\\\"1830\\\"/></REFERENCES></ITEM>\\n<ITEM UNIQUEID=\\\"LATERAL\\\" DESCRIPTION=\\\"Lateral demonstracao\\\" WIDTH=\\\"500\\\" DEPTH=\\\"800\\\" HEIGHT=\\\"15\\\" REPETITION=\\\"3\\\" PLATECUTTINGROTATE=\\\"NONE\\\"><REFERENCES><MATERIAL REFERENCE=\\\"MDF\\\"/><MODEL REFERENCE=\\\"Branco\\\"/><THICKNESS REFERENCE=\\\"15\\\"/><MAXWIDTH REFERENCE=\\\"2750\\\"/><MAXDEPTH REFERENCE=\\\"1830\\\"/></REFERENCES></ITEM>\\n<ITEM UNIQUEID=\\\"PRATELEIRA\\\" DESCRIPTION=\\\"Prateleira demonstracao\\\" WIDTH=\\\"450\\\" DEPTH=\\\"350\\\" HEIGHT=\\\"15\\\" REPETITION=\\\"4\\\" PLATECUTTINGROTATE=\\\"NONE\\\"><REFERENCES><MATERIAL REFERENCE=\\\"MDF\\\"/><MODEL REFERENCE=\\\"Branco\\\"/><THICKNESS REFERENCE=\\\"15\\\"/><MAXWIDTH REFERENCE=\\\"2750\\\"/><MAXDEPTH REFERENCE=\\\"1830\\\"/></REFERENCES></ITEM>\\n</ITEMS></ITEM>\\n</ITEMS></CATEGORY></CATEGORIES></AMBIENT></AMBIENTS></LISTING>\\n\", \"substituir\": true}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"Cadastro automático\",()=>pm.expect(pm.response.json().chapasCriadas).to.eql(1));"
            ]
          }
        }
      ]
    },
