        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Administrador teste\",\n  \"empresa\": \"Oficina demonstracao\",\n  \"email\": \"{{emailTeste}}\",\n  \"senha\": \"{{senhaTeste}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"emailTeste\", \"teste-\" + Date.now() + \"@example.test\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
