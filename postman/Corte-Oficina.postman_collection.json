{
  "info": {
    "name": "Corte Oficina 1.2 - fluxo completo",
    "description": "Execute em ordem em ambiente de teste. Cookies de sessão precisam estar habilitados. Cria empresa, projeto e estoque fictícios. JSON exportado não é .lote.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "senhaTeste",
      "value": "senha-demonstracao-1234"
    }
  ],
